@jobs
task: ensemble
@end

@method settings
basis: sto-3g
@end

@ensemble
description: bithiophene in water
topology file: bithio.tpr
trajectory file: bithio.xtc
start: 300
end: 400
num snapshots: 2
qm region: resname RES
qm charge: 0
qm multiplicity: 1
pe cutoff: 3.0
npe cutoff: 4.5
pe model: SEP
npe model: tip3p
@end

@spectrum settings
line profile: gaussian
broadening parameter: 0.4
units: eV
@end

@response
property: absorption
nstates: 2
@end
