# Caffeine, B3LYP, def2-SVP: S1 geometry optimization, RPA with 5 states, 3 steps (RI-JK).
@jobs
task: optimize
@end

@method settings
xcfun: b3lyp
basis: def2-svp
@end

@response
property: absorption
nstates: 5
@end

@gradient
state_deriv_index: 1
@end

@optimize
max_iter: 3
conv_maxiter: yes
@end

@molecule
charge: 0
multiplicity: 1
xyzfile: caffeine.xyz
@end
