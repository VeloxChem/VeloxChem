# Caffeine, B3LYP, def2-SVP: TDDFT gradient of S1, RPA with 5 states (RI-JK).
@jobs
task: gradient
@end

@method settings
xcfun: b3lyp
basis: def2-svp
@end

@response
property: absorption
nstates: 5
@end

@gradient
state_deriv_index: 1
@end

@molecule
charge: 0
multiplicity: 1
xyzfile: caffeine.xyz
@end
