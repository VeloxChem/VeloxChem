]*PQ_f[d0]*QD_1_f + PA_1_f*PQ_f[c0]*PQ_f[d1]*QD_0_f + PA_1_f*PQ_f[d0]*PQ_f[d1]*QC_0_f) + (delta_f[a0][b0]*delta_f[b1][d0] + delta_f[a0][b1]*delta_f[b0][d0] + delta_f[a0][d0]*delta_f[b0][b1])*(PA_1_f*PQ_f[c0]*PQ_f[c1]*QD_1_f + PA_1_f*PQ_f[c0]*PQ_f[d1]*QC_1_f + PA_1_f*PQ_f[c1]*PQ_f[d1]*QC_0_f) + (delta_f[a0][b0]*delta_f[b1][d1] + delta_f[a0][b1]*delta_f[b0][d1] + delta_f[a0][d1]*delta_f[b0][b1])*(PA_1_f*PQ_f[c0]*PQ_f[c1]*QD_0_f + PA_1_f*PQ_f[c0]*PQ_f[d0]*QC_1_f + PA_1_f*PQ_f[c1]*PQ_f[d0]*QC_0_f) + (delta_f[a1][b0]*delta_f[b1][c0] + delta_f[a1][b1]*delta_f[b0][c0] + delta_f[a1][c0]*delta_f[b0][b1])*(PA_0_f*PQ_f[c1]*PQ_f[d0]*QD_1_f + PA_0_f*PQ_f[c1]*PQ_f[d1]*QD_0_f + PA_0_f*PQ_f[d0]*PQ_f[d1]*QC_1_f) + (delta_f[a1][b0]*delta_f[b1][c1] + delta_f[a1][b1]*delta_f[b0][c1] + delta_f[a1][c1]*delta_f[b0][b1])*(PA_0_f*PQ_f[c0]*PQ_f[d0]*QD_1_f + PA_0_f*PQ_f[c0]*PQ_f[d1]*QD_0_f + PA_0_f*PQ_f[d0]*PQ_f[d1]*QC_0_f) + (delta_f[a1][b0]*delta_f[b1][d0] + delta_f[a1][b1]*delta_f[b0][d0] + delta_f[a1][d0]*delta_f[b0][b1])*(PA_0_f*PQ_f[c0]*PQ_f[c1]*QD_1_f + PA_0_f*PQ_f[c0]*PQ_f[d1]*QC_1_f + PA_0_f*PQ_f[c1]*PQ_f[d1]*QC_0_f) + (delta_f[a1][b0]*delta_f[b1][d1] + delta_f[a1][b1]*delta_f[b0][d1] + delta_f[a1][d1]*delta_f[b0][b1])*(PA_0_f*PQ_f[c0]*PQ_f[c1]*QD_0_f + PA_0_f*PQ_f[c0]*PQ_f[d0]*QC_1_f + PA_0_f*PQ_f[c1]*PQ_f[d0]*QC_0_f)

                            -(PQ_f[c0]*PQ_f[c1]*(PQ_f[d0]*QD_1_f + PQ_f[d1]*QD_0_f) + PQ_f[d0]*PQ_f[d1]*(PQ_f[c0]*QC_1_f + PQ_f[c1]*QC_0_f))*(delta_f[a0][a1]*delta_f[b0][b1] + delta_f[a0][b0]*delta_f[a1][b1] + delta_f[a0][b1]*delta_f[a1][b0])

                        )

                        + F8_t_f[3] * (-0.25f) * S2_f * S2_f * inv_S1_f * inv_S4_f * inv_S4_f * inv_S4_f * (

                            +(PQ_f[a0]*(PQ_f[a1]*delta_f[b0][b1] + PQ_f[b0]*delta_f[a1][b1] + PQ_f[b1]*delta_f[a1][b0]) + PQ_f[a1]*(PQ_f[b0]*delta_f[a0][b1] + PQ_f[b1]*delta_f[a0][b0]) + PQ_f[b0]*PQ_f[b1]*delta_f[a0][a1])*(QC_0_f*(QC_1_f*delta_f[d0][d1] + QD_0_f*delta_f[c1][d1] + QD_1_f*delta_f[c1][d0]) + QC_1_f*(QD_0_f*delta_f[c0][d1] + QD_1_f*delta_f[c0][d0]) + QD_0_f*QD_1_f*delta_f[c0][c1])

                            +QC_0_f*QC_1_f*(QD_0_f*(PQ_f[a0]*(delta_f[a1][b0]*delta_f[b1][d1] + delta_f[a1][b1]*delta_f[b0][d1] + delta_f[a1][d1]*delta_f[b0][b1]) + PQ_f[a1]*(delta_f[a0][b0]*delta_f[b1][d1] + delta_f[a0][b1]*delta_f[b0][d1] + delta_f[a0][d1]*delta_f[b0][b1]) + PQ_f[b0]*(delta_f[a0][a1]*delta_f[b1][d1] + delta_f[a0][b1]*delta_f[a1][d1] + delta_f[a0][d1]*delta_f[a1][b1]) + PQ_f[b1]*(delta_f[a0][a1]*delta_f[b0][d1] + delta_f[a0][b0]*delta_f[a1][d1] + delta_f[a0][d1]*delta_f[a1][b0])) + QD_1_f*(PQ_f[a0]*(delta_f[a1][b0]*delta_f[b1][d0] + delta_f[a1][b1]*delta_f[b0][d0] + delta_f[a1][d0]*delta_f[b0][b1]) + PQ_f[a1]*(delta_f[a0][b0]*delta_f[b1][d0] + delta_f[a0][b1]*delta_f[b0][d0] + delta_f[a0][d0]*delta_f[b0][b1]) + PQ_f[b0]*(delta_f[a0][a1]*delta_f[b1][d0] + delta_f[a0][b1]*delta_f[a1][d0] + delta_f[a0][d0]*delta_f[a1][b1]) + PQ_f[b1]*(delta_f[a0][a1]*delta_f[b0][d0] + delta_f[a0][b0]*delta_f[a1][d0] + delta_f[a0][d0]*delta_f[a1][b0]))) + QD_0_f*QD_1_f*(QC_0_f*(PQ_f[a0]*(delta_f[a1][b0]*delta_f[b1][c1] + delta_f[a1][b1]*delta_f[b0][c1] + delta_f[a1][c1]*delta_f[b0][b1]) + PQ_f[a1]*(delta_f[a0][b0]*delta_f[b1][c1] + delta_f[a0][b1]*delta_f[b0][c1] + delta_f[a0][c1]*delta_f[b0][b1]) + PQ_f[b0]*(delta_f[a0][a1]*delta_f[b1][c1] + delta_f[a0][b1]*delta_f[a1][c1] + delta_f[a0][c1]*delta_f[a1][b1]) + PQ_f[b1]*(delta_f[a0][a1]*delta_f[b0][c1] + delta_f[a0][b0]*delta_f[a1][c1] + delta_f[a0][c1]*delta_f[a1][b0])) + QC_1_f*(PQ_f[a0]*(delta_f[a1][b0]*delta_f[b1][c0] + delta_f[a1][b1]*delta_f[b0][c0] + delta_f[a1][c0]*delta_f[b0][b1]) + PQ_f[a1]*(delta_f[a0][b0]*delta_f[b1][c0] + delta_f[a0][b1]*delta_f[b0][c0] + delta_f[a0][c0]*delta_f[b0][b1]) + PQ_f[b0]*(delta_f[a0][a1]*delta_f[b1][c0] + delta_f[a0][b1]*delta_f[a1][c0] + delta_f[a0][c0]*delta_f[a1][b1]) + PQ_f[b1]*(delta_f[a0][a1]*delta_f[b0][c0] + delta_f[a0][b0]*delta_f[a1][c0] + delta_f[a0][c0]*delta_f[a1][b0])))

                            +(QC_0_f*QD_1_f*(PQ_f[c1]*QD_0_f + PQ_f[d0]*QC_1_f) + QC_1_f*QD_0_f*(PQ_f[c0]*QD_1_f + PQ_f[d1]*QC_0_f))*(delta_f[a0][a1]*delta_f[b0][b1] + delta_f[a0][b0]*delta_f[a1][b1] + delta_f[a0][b1]*delta_f[a1][b0])

                        )


                    );

            ERIs[threadIdx.y][threadIdx.x] += (double)eri_ijkl_f * mat_D_full_AO[j_cgto * naos + l_cgto];
